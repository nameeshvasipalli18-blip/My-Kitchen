# Brevo transactional email (backend only). Fill these in to enable Brevo.
BREVO_API_KEY=
BREVO_TEMPLATE_ID=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Kitchen split

# Use your full frontend Vercel URL in production.
FRONTEND_URL=http://localhost:5173
# Optional full reset page override; normally derived from FRONTEND_URL.
# PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Use persistent PostgreSQL for deployment; omit for local SQLite development.
# MY_KITCHEN_DATABASE_URL=postgresql://user:password@host/database

# Optional SMTP fallback, used only when no Brevo configuration is present.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=no-reply@example.com
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_USE_TLS=true
